# Copy to .env.docker on the server and fill in real values.
# Never commit .env.docker.

# Which SQLite file to use: "production" (db.sqlite3) or "development" (test.db.sqlite3)
DB_NAME=production

# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-me-with-a-long-random-string

DEBUG=False

# Comma-separated hostnames/IPs the server answers on
ALLOWED_HOSTS=your-domain.example.com,203.0.113.10

# Needed for admin/form POSTs when served over HTTPS behind a proxy
CSRF_TRUSTED_ORIGINS=https://your-domain.example.com

# Shared secret remote sensors send in X-Api-Key. Leave empty to keep ingest disabled.
SENSOR_API_KEY=
